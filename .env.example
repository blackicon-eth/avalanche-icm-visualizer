# Read-only Avalanche C-Chain RPC.
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Dexalot L1 public RPC (chain ID 432204 / 0x6984c).
NEXT_PUBLIC_DEXALOT_RPC_URL=https://subnets.avax.network/dexalot/mainnet/rpc

# Official ICM deployment documented by Avalanche Builder Hub.
# TeleporterMessenger is universal across supported chains for this release.
NEXT_PUBLIC_TELEPORTER_MESSENGER_ADDRESS=0x253b2784c75e510dD0fF1da844684a1aC0aa5fcf

# Warp Messenger is a native precompile, not a normal deployed contract.
# Configure its address in the chain adapter when Warp log scanning is enabled.
NEXT_PUBLIC_WARP_MESSENGER_ADDRESS=0x0200000000000000000000000000000000000005
